@startuml c4-component
' C4, уровень 3 — Component: внутреннее устройство контейнера «Серверное приложение» (apps/bot/src).
!pragma layout smetana
!include <C4/C4_Component>
UpdateLegendTitle("Легенда")
title C4 · Уровень 3 · Компоненты контейнера «Серверное приложение»

Container(caddy, "Обратный прокси", "Caddy 2")
ContainerDb(pg, "База данных", "PostgreSQL 17 + pgvector")
ContainerQueue(redis, "Брокер очередей", "Redis 7")
System_Ext(telegram, "Telegram Bot API")
System_Ext(ai, "Yandex Cloud AI", "SpeechKit, YandexGPT, Embeddings")
System_Ext(openai, "OpenAI Whisper", "по настройке")
System_Ext(yabilling, "Yandex Cloud Billing API")
System_Ext(robokassa, "Робокасса")

Container_Boundary(bot, "Серверное приложение (один процесс Node.js)") {
  Component(http, "HTTP-сервер", "Express 5 (http/)", "Маршруты /telegram/webhook, /health, /docs, монтаж роутеров")
  Component(handlers, "Обработчики Telegram", "grammY (bot/handlers)", "Команды, кнопки, приём сообщений, онбординг, меню, карточки дел, платежи Stars")
  Component(adminapi, "API админ-панели", "Express router (http/admin, modules/admin)", "Вход: пароль + TOTP; метрики, промпты, рассылки, настройки; журнал доступа к ПД")
  Component(payhook, "Приём платёжных уведомлений", "Express router (http/billing)", "Проверка подписи Робокассы, идемпотентность")
  Component(gateway, "Шлюз входящих", "modules/gateway", "Дедупликация апдейтов, сохранение сырого сообщения — в одной транзакции")
  Component(buffer, "Буфер выгрузок", "modules/buffer", "Склеивает серию сообщений, закрывает по тишине/потолку")
  Component(pipeline, "Конвейер разбора", "modules/pipeline, воркер BullMQ «pipeline»", "Выгрузки пользователя строго по очереди под замком; до 5 попыток")
  Component(aistages, "ИИ-этапы", "modules/router, extractor, classifier, resolver, projects, presenter", "Намерения → единицы → классификация → правки старых записей → ответ")
  Component(providers, "Адаптеры внешних API", "modules/*/providers", "SpeechKit / Whisper, YandexGPT, эмбеддинги, Робокасса, Stars — за интерфейсами с mock-реализациями")
  Component(scheduler, "Планировщик", "modules/scheduler (таймер 60 с)", "Сводки утром/вечером, напоминания о сроках, режим тишины")
  Component(billing, "Подписка и оплата", "modules/billing", "Доступ (пробный период/подписка), счета, продления, промокоды")
  Component(broadcast, "Рассылка", "modules/broadcast, воркер BullMQ «broadcast»", "Отправка порциями с заданным темпом")
  Component(privacy, "Приватность", "modules/privacy", "Экспорт и удаление данных, удаление неактивных")
  Component(cloud, "Сторож баланса", "modules/cloud", "Баланс Yandex Cloud для панели и оповещений")
  Component(repos, "Репозитории", "*.repo.ts, Drizzle ORM", "Доступ к таблицам")
  Component(infra, "Инфраструктура", "infra/", "Очереди, распределённый замок, мониторинг и оповещения, логирование, повторы")
}

Rel(caddy, http, "Запросы", "HTTP :3000")
Rel(http, handlers, "Апдейт Telegram", "webhookCallback")
Rel(http, adminapi, "/admin/api/*")
Rel(http, payhook, "/billing/robokassa/result")
Rel(handlers, gateway, "Принять апдейт")
Rel(handlers, buffer, "Прикрепить сообщение к выгрузке")
Rel(handlers, billing, "Платежи Stars")
Rel(handlers, privacy, "/export_my_data, /delete_my_data")
Rel(handlers, infra, "Отложенное закрытие по тишине (close-batch)")
Rel(handlers, aistages, "Кнопки «Это новое», открытие цели: классификатор, шаги")
Rel(adminapi, infra, "Рассылка, перезапуск выгрузки")
Rel(infra, redis, "BullMQ, замки", "RESP")
Rel(infra, pipeline, "Задания close-batch и process-user")
Rel(pipeline, buffer, "Закрыть выгрузку по тишине, склеить текст")
Rel(pipeline, providers, "Расшифровка речи")
Rel(infra, telegram, "Оповещения мониторинга", "Bot API")
Rel(infra, broadcast, "Задание send")
Rel(pipeline, aistages, "Разобрать выгрузку")
Rel(aistages, providers, "Вызовы моделей")
Rel(providers, ai, "HTTPS REST/JSON")
Rel(providers, openai, "HTTPS multipart")
Rel(providers, robokassa, "HTTPS")
Rel(providers, telegram, "Счета и возвраты Stars", "Bot API")
Rel(aistages, telegram, "Ответ пользователю", "Bot API")
Rel(scheduler, telegram, "Напоминания", "Bot API")
Rel(broadcast, telegram, "Сообщения рассылки", "Bot API")
Rel(cloud, yabilling, "Остаток на счёте", "HTTPS")
Rel(payhook, billing, "Применить событие оплаты")
Rel(billing, providers, "Счета, списания")
Rel(gateway, repos, "")
Rel(buffer, pg, "batches, messages_raw напрямую", "SQL")
Rel(pipeline, pg, "Статусы выгрузок напрямую", "SQL")
Rel(aistages, repos, "")
Rel(scheduler, repos, "")
Rel(billing, repos, "")
Rel(privacy, repos, "")
Rel(adminapi, repos, "")
Rel(repos, pg, "SQL", "pg + Drizzle")
SHOW_LEGEND()
@enduml
